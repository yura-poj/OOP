<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.GridPane?>

<?import javafx.scene.text.Text?>
<?import javafx.scene.layout.HBox?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="ru.nsu.pozhidaev.GameController">
    <HBox spacing="10">
        <Label fx:id="scoreLabel"/>
        <Text text=" | "/>
        <Label fx:id="bestScoreLabel"/>
        <Text text=" | "/>
        <Text fx:id="looseText" text="You lose" visible="false"/>
        <Text fx:id="winText" text="You win" visible="false"/>
    </HBox>
    <Pane fx:id="gamePane" onKeyPressed="#handleKeyPress" focusTraversable="true">
        <GridPane fx:id="gameGrid">
            <children>
            </children>
        </GridPane>
    </Pane>
    <VBox fx:id="buttonBox" spacing="10" alignment="CENTER" visible="false">
        <Button fx:id="againButton" text="Again" onAction="#handleAgain"/>
        <Button fx:id="exitButton" text="Exit" onAction="#handleExit" />
    </VBox>

</VBox>